#!/usr/bin/env bash
# pre-push: runs "make preflight" before a push. On by default once "make hooks-install" has run.
# Turn it off in a clone with "make preflight-hook-off". Skip it once with: git push --no-verify
# A push that only deletes a branch is not checked.
set -e

if [ "$(git config --get --bool kritva.preflightOnPush || echo true)" = "false" ]; then
  exit 0
fi

zero=0000000000000000000000000000000000000000
pushing=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] || pushing=1
done
[ "$pushing" = 1 ] || exit 0

echo "[pre-push] Running make preflight (turn off: make preflight-hook-off; skip once: --no-verify)..."
make preflight
